# Copy this file to .env.local for local development.
# On Vercel, set these same names under Project Settings -> Environment Variables.

AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET=rounds-golf-data
DATAGOLF_KEY=your_datagolf_key_here

# Predictions microservice (Lambda + API Gateway) -- replaces the old
# internal /api/predictions route. NEXT_PUBLIC_ prefix is required since
# this is called directly from the browser (client component).
NEXT_PUBLIC_PREDICTIONS_API_URL=https://nhrr1kvn82.execute-api.us-east-1.amazonaws.com

# Auth
NEXTAUTH_SECRET=generate_a_random_string_here
NEXTAUTH_URL=http://localhost:3000
USERS_TABLE_NAME=golf-dashboard-users



